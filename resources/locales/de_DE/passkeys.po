msgid ""
msgstr ""
"Project-Id-Version: dereuromark/cakephp-passkeys\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de_DE\n"

msgid "Add a passkey"
msgstr "Passkey hinzufügen"

msgid "Add a passkey to sign in on this device without your password."
msgstr "Füge einen Passkey hinzu, um dich auf diesem Gerät ohne Passwort anzumelden."

msgid "Add another passkey"
msgstr "Weiteren Passkey hinzufügen"

msgid "Added"
msgstr "Hinzugefügt"

msgid "Delete"
msgstr "Löschen"

msgid "Delete this passkey?"
msgstr "Diesen Passkey löschen?"

msgid "Last used"
msgstr "Zuletzt verwendet"

msgid "Name"
msgstr "Name"

msgid "Name cannot be empty."
msgstr "Name darf nicht leer sein."

msgid "Not now"
msgstr "Später"

msgid "Passkey"
msgstr "Passkey"

msgid "Passkeys"
msgstr "Passkeys"

msgid "Passkeys are a faster, phishing-resistant way to sign in. They live on your device and unlock with your fingerprint, face, or PIN."
msgstr "Passkeys sind eine schnellere, Phishing-resistente Möglichkeit, sich anzumelden. Sie leben auf deinem Gerät und werden mit deinem Fingerabdruck, Gesicht oder deiner PIN entsperrt."

msgid "Rename"
msgstr "Umbenennen"

msgid "Sign in faster next time"
msgstr "Nächstes Mal schneller anmelden"

msgid "Sign in with a passkey"
msgstr "Mit Passkey anmelden"

msgid "Type"
msgstr "Typ"

msgid "What's a passkey?"
msgstr "Was ist ein Passkey?"

msgid "You haven't added any passkeys yet."
msgstr "Du hast noch keine Passkeys hinzugefügt."

msgid "You've reached your limit of {0} passkeys."
msgstr "Du hast dein Limit von {0} Passkeys erreicht."

msgid "never"
msgstr "nie"

msgid "New name for this passkey"
msgstr "Neuer Name für diesen Passkey"

msgid "Invalid action name."
msgstr "Ungültiger Aktionsname."

msgid "Login challenge missing or expired."
msgstr "Die Anmeldeanfrage fehlt oder ist abgelaufen."

msgid "Too many attempts. Try again later."
msgstr "Zu viele Versuche. Bitte später erneut versuchen."

msgid "Unknown passkey credential."
msgstr "Unbekannter Passkey."

msgid "You cannot add a passkey right now."
msgstr "Du kannst gerade keinen Passkey hinzufügen."

msgid "You cannot delete this passkey right now."
msgstr "Du kannst diesen Passkey gerade nicht löschen."

msgid "List the passkeys of a user."
msgstr "Listet die Passkeys eines Benutzers auf."

msgid "User id."
msgstr "Benutzer-ID."

msgid "No passkeys found for user {0}."
msgstr "Keine Passkeys für Benutzer {0} gefunden."

msgid "Id"
msgstr "ID"

msgid "Created"
msgstr "Erstellt"

msgid "Authenticator"
msgstr "Authenticator"

msgid "Delete one passkey of a user, or all of them."
msgstr "Löscht einen Passkey eines Benutzers oder alle."

msgid "Passkey id. Without it, all passkeys of the user are deleted."
msgstr "Passkey-ID. Ohne sie werden alle Passkeys des Benutzers gelöscht."

msgid "Do not ask before deleting all passkeys."
msgstr "Vor dem Löschen aller Passkeys nicht nachfragen."

msgid "User {0} has no passkey {1}."
msgstr "Benutzer {0} hat keinen Passkey {1}."

msgid "Delete all {0} passkeys of user {1}?"
msgstr "Alle {0} Passkeys von Benutzer {1} löschen?"

msgid "Nothing deleted."
msgstr "Nichts gelöscht."

msgid "Deleted passkey {0} ({1})."
msgstr "Passkey {0} ({1}) gelöscht."
msgid "This type of passkey is not allowed here."
msgstr "Diese Art von Passkey ist hier nicht erlaubt."
msgid "{0}: a passkey was added to your account"
msgstr "{0}: Zu deinem Konto wurde ein Passkey hinzugefügt"

msgid "Hi {0},"
msgstr "Hallo {0},"

msgid "A passkey was added to your {0} account."
msgstr "zu deinem Konto bei {0} wurde ein Passkey hinzugefügt."

msgid "Name: {0}"
msgstr "Name: {0}"

msgid "Device: {0}"
msgstr "Gerät: {0}"

msgid "Added: {0}"
msgstr "Hinzugefügt: {0}"

msgid "If this was you, there is nothing to do."
msgstr "Wenn du das warst, musst du nichts tun."

msgid "If it was not you, someone else may be signed in to your account. Sign in, remove this passkey and secure your account."
msgstr "Wenn du es nicht warst, ist möglicherweise jemand anderes in deinem Konto angemeldet. Melde dich an, entferne diesen Passkey und sichere dein Konto ab."

msgid "Manage your passkeys"
msgstr "Passkeys verwalten"

msgid "Manage your passkeys: {0}"
msgstr "Passkeys verwalten: {0}"
